# Quorra: AWS's 001-support-saml.patch from openvpn3-3.11.5-aws-1, rebased onto OpenVPN 3.11.7.
# Only the trailing context of the APP_MSG_MAX hunk in openvpn/ssl/proto.hpp differs from AWS's copy.
# =============================================================================
# SAML Support Patch for OpenVPN 3
# =============================================================================
#
# This patch adds SAML authentication support to OpenVPN 3 by extending
# buffer handling and protocol message sizes to accommodate larger SAML tokens.
#
# Modifications made by: Amazon Web Services
# Purpose: Enable SAML-based authentication with larger token support
# Date: 2025-11-25
#
# Key changes:
# 1. Extended APP_MSG_MAX from 64KB to 128KB for SAML tokens
# 2. Changed auth string length prefix from 2 bytes to 4 bytes
# 3. Added advance_string32() for 32-bit length prefixes
# 4. Updated read/write functions for 32-bit length handling
# =============================================================================

diff --git a/openvpn/buffer/bufcomplete.hpp b/openvpn/buffer/bufcomplete.hpp
index 12345678..87654321 100644
--- a/openvpn/buffer/bufcomplete.hpp
+++ b/openvpn/buffer/bufcomplete.hpp
@@ -49,6 +49,23 @@
         return advance(size_t(h) << 8 | size_t(l));
     }
 
+#ifdef UNIT_TEST
+    // assumes embedded big-endian uint32_t length in the stream
+    bool advance_string32()
+    {
+        std::uint8_t b0, b1, b2, b3;
+        if (!get(b0))
+            return false;
+        if (!get(b1))
+            return false;
+        if (!get(b2))
+            return false;
+        if (!get(b3))
+            return false;
+        return advance(size_t(b0) << 24 | size_t(b1) << 16 | size_t(b2) << 8 | size_t(b3));
+    }
+#endif
+
     bool advance_to_null()
     {
         std::uint8_t c;

