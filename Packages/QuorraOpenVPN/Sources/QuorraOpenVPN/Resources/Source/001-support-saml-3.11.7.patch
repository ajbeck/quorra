+            buf->read((unsigned char *)&key_length, sizeof(key_length));
+
+            if (buf->size() < 1)
+                throw proto_error("auth buffer too small for auth_prefix remainder");
+
+            unsigned char auth_suffix;
+            buf->read(&auth_suffix, 1);
